# Copy to .env.development (and .env.production) and fill in real values.
# Do NOT commit the filled-in files — they are gitignored.

NODE_ENV=development
PORT=3001
MONGO_URI=

# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=14d
JWT_COOKIE_EXPIRES_IN=14

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=

# Cloudinary — required for blog cover-image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI blog-assist. Endpoints return 503 until these are set.
ANTHROPIC_API_KEY=
RECRAFT_API_KEY=
