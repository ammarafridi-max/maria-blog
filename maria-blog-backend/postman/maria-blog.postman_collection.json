{
  "info": {
    "_postman_id": "b1a7c0de-0000-4a00-9a00-maria0blog001",
    "name": "Maria Blog API",
    "description": "All maria-blog-backend endpoints (auth, admin users, blogs, blog tags).\n\nAuth uses an httpOnly `jwt` cookie. Run **Auth > Login** first; Postman's cookie jar stores the cookie for `{{baseUrl}}` and sends it automatically on every protected request (use the Postman desktop app so the cookie jar is active).\n\nHandy collection variables are auto-filled by test scripts: logging in sets `adminUsername`; creating a blog/tag sets `blogId`/`blogSlug`/`tagId`.\n\nSet `baseUrl` to your running backend (defaults to http://localhost:3001).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Liveness probe. Returns { status: 'ok', brand: 'maria-blog' }."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res && res.data && res.data.username) {",
                  "    pm.collectionVariables.set('adminUsername', res.data.username);",
                  "  }",
                  "  pm.test('logged in', () => pm.expect(res.status).to.eql('success'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ammar.afridi95@gmail.com\",\n  \"password\": \"Obaid123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Authenticate an admin. Sets the httpOnly `jwt` cookie used by every protected route."
          },
          "response": []
        },
        {
          "name": "Get current admin (auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Returns the logged-in admin (from the cookie)."
          },
          "response": []
        },
        {
          "name": "Update current admin (auth/me)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ammar Afridi\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Update your own name/email. Only `name` and `email` are allowed."
          },
          "response": []
        },
        {
          "name": "Update password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordCurrent\": \"Obaid123\",\n  \"password\": \"NewPass123\",\n  \"passwordConfirm\": \"NewPass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/update-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "update-password"] },
            "description": "Change your own password. Re-issues the cookie."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Clears the `jwt` cookie."
          },
          "response": []
        }
      ]
    },
    {
