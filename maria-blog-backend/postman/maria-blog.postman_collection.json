              "raw": "{\n  \"name\": \"Test Writer\",\n  \"username\": \"testwriter1\",\n  \"email\": \"writer@example.com\",\n  \"password\": \"WriterPass123\",\n  \"role\": \"blog-manager\",\n  \"status\": \"ACTIVE\"\n}",
