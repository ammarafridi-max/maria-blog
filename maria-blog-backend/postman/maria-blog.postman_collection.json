    {
      "name": "Blogs",
      "item": [
        {
          "name": "List published blogs (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?page=1&limit=9&tag=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "9" },
                { "key": "tag", "value": "", "description": "filter by tag name" }
              ]
            },
            "description": "Public. Only published posts."
          },
          "response": []
        },
        {
          "name": "Get published blog by slug (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/blogs/slug/{{blogSlug}}", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "slug", "{{blogSlug}}"] },
            "description": "Public."
          },
          "response": []
        },
        {
          "name": "Admin list blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/admin/list?page=1&limit=10&status=&search=&tag=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blogs", "admin", "list"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "", "description": "draft | published | scheduled" },
                { "key": "search", "value": "" },
                { "key": "tag", "value": "" }
              ]
            },
            "description": "admin / blog-manager. All statuses."
          },
          "response": []
        },
        {
          "name": "Create blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data._id) pm.collectionVariables.set('blogId', res.data._id);",
                  "  if (res.data && res.data.slug) pm.collectionVariables.set('blogSlug', res.data.slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Five Ways to Ease Lower Back Pain", "type": "text" },
                { "key": "slug", "value": "", "type": "text", "description": "optional; auto-generated from title" },
                { "key": "content", "value": "<p>Lower back pain is common and usually settles with the right movement.</p><h2>Keep moving</h2><p>Gentle walking beats bed rest for most people.</p>", "type": "text" },
                { "key": "excerpt", "value": "Simple, practical steps to ease everyday lower back pain.", "type": "text" },
                { "key": "quickAnswer", "value": "Keep moving gently, break up long sitting, and build back to normal activity.", "type": "text" },
                { "key": "status", "value": "draft", "type": "text", "description": "draft | published | scheduled" },
                { "key": "tags", "value": "Back Pain", "type": "text", "description": "repeat this key for multiple tags; must already exist" },
                { "key": "metaTitle", "value": "", "type": "text" },
                { "key": "metaDescription", "value": "", "type": "text" },
                { "key": "faqs", "value": "[{\"question\":\"Should I rest completely?\",\"answer\":\"Gentle movement usually helps more than bed rest.\"}]", "type": "text", "description": "JSON array string" },
                { "key": "scheduledAt", "value": "", "type": "text", "description": "ISO date, required when status=scheduled" },
                { "key": "coverImage", "type": "file", "src": [], "description": "required when status is published/scheduled" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/blogs", "host": ["{{baseUrl}}"], "path": ["api", "blogs"] },
            "description": "admin / blog-manager. Multipart form. Attach a file to `coverImage`. Tags must already exist (create them first)."
          },
          "response": []
        },
        {
          "name": "Get blog by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/blogs/{{blogId}}", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "{{blogId}}"] },
            "description": "admin / blog-manager."
          },
          "response": []
        },
        {
          "name": "Update blog",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Five Ways to Ease Lower Back Pain (updated)", "type": "text" },
                { "key": "content", "value": "<p>Updated content.</p>", "type": "text" },
                { "key": "status", "value": "draft", "type": "text" },
                { "key": "newCoverImage", "type": "file", "src": [], "description": "optional new cover image" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/blogs/{{blogId}}", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "{{blogId}}"] },
            "description": "admin / blog-manager. Multipart. All fields optional; cover file field is `newCoverImage`."
          },
          "response": []
        },
        {
          "name": "Publish blog",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/blogs/{{blogId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "{{blogId}}", "publish"] },
            "description": "admin / blog-manager. Sets status=published now."
          },
          "response": []
        },
        {
          "name": "Duplicate blog",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/blogs/{{blogId}}/duplicate", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "{{blogId}}", "duplicate"] },
            "description": "admin / blog-manager. Creates a draft copy."
          },
          "response": []
        },
        {
          "name": "Delete blog",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/blogs/{{blogId}}", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "{{blogId}}"] },
            "description": "admin / blog-manager."
          },
          "response": []
        },
        {
          "name": "Improve content (AI)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Five Ways to Ease Lower Back Pain\",\n  \"content\": \"<p>back pain is bad. you should move. it helps a lot.</p>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/blogs/improve-content", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "improve-content"] },
            "description": "admin / blog-manager. Requires ANTHROPIC_API_KEY on the server (else 503)."
          },
          "response": []
        },
        {
          "name": "Generate cover image (AI)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Five Ways to Ease Lower Back Pain\",\n  \"excerpt\": \"Simple steps to ease back pain.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/blogs/generate-cover", "host": ["{{baseUrl}}"], "path": ["api", "blogs", "generate-cover"] },
            "description": "admin / blog-manager. Requires RECRAFT_API_KEY on the server (else 503). Returns an image (webp) body."
          },
          "response": []
        }
      ]
    },
