# Copy to .env.local and fill in. The filled-in file is gitignored.

# Base URL of maria-blog-backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Public site origin (canonical URLs + JSON-LD). Set to the real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — TinyMCE cloud key for the blog editor
NEXT_PUBLIC_TINYMCE_API_KEY=

# Optional analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
